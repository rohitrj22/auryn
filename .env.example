# Optional. Auryn runs fully without this.
# With no key, the deterministic `mock` provider is used and every proof passes.
# With a key, agents use gemini-3.8-flash and the model decides what to remember.
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# FALKORDB_URL=falkor://localhost:6379
# AURYN_PROVIDER=mock
